{ Test: Múltiples errores semánticos combinados }
PROGRAM TestMultiplesErrores
VAR
    x : INT;
    y : INT;
    x : REAL;                       { ERROR: 'x' ya declarada }

FUNCTION procesar(INT a): INT
BEGIN
    procesar := a + z               { ERROR: 'z' no declarada }
END

BEGIN
    { Múltiples errores }
    x := 10;
    w := 20;                        { ERROR: 'w' no declarada }
    x := x + "texto";               { ERROR: INT + STRING }
    y := noExiste(5);               { ERROR: 'noExiste' no declarada }
    y := procesar(10, 20);          { ERROR: número de argumentos incorrecto }
    x := procesar("hola");           { ERROR: tipo de argumento incorrecto }
END.
