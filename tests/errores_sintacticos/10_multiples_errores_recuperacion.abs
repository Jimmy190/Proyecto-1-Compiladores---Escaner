PROGRAM MultipleErrores
VAR
    x, y : ;
    nombre : STRING;

FUNCTION Suma(INT a b): INT
BEGIN
    x := 10 + ;
    Suma := a + b;
END

BEGIN
    IF x > 5
    BEGIN
        WRITE("Test");
    END
    
    WHILE DO
    BEGIN
        x++;
    END
    
    FOR i = 1 TO 10 DO
    BEGIN
        WRITE(i);
    END
    
    READ x);
    WRITE;
END
